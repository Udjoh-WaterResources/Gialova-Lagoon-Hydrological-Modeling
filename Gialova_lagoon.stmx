	<model_units>
		<unit name="Dimensionless">
			<eqn>1</eqn>
			<alias>dmnl</alias>
			<alias>unitless</alias>
			<alias>fraction</alias>
		</unit>
		<unit name="Cubic Meters">
			<eqn>Meters^3</eqn>
			<alias>cubic meter</alias>
			<alias>cu m</alias>
		</unit>
		<unit name="Meters">
			<eqn/>
			<alias>m</alias>
			<alias>meter</alias>
		</unit>
		<unit name="Square Meters">
			<eqn>Meters^2</eqn>
			<alias>sq m</alias>
			<alias>square meter</alias>
		</unit>
		<unit name="Kilograms">
			<eqn/>
			<alias>kg</alias>
			<alias>kilogram</alias>
		</unit>
		<unit name="Years">
			<eqn/>
			<alias>yr</alias>
			<alias>year</alias>
		</unit>
	</model_units>
	<model>
		<variables>
			<stock name="Lagoon Volume">
				<eqn>1350000</eqn>
				<inflow>Xerolagados_Catchment_Runoff</inflow>
				<inflow>Precipitation_Direct</inflow>
				<inflow>Tyflomitis_Groundwater</inflow>
				<inflow>Sea_exchange</inflow>
				<outflow>Evaporative_loss_via_Turc_PET</outflow>
				<non_negative/>
				<units>Cubic Meters</units>
			</stock>
			<flow name="Xerolagados Catchment Runoff">
				<eqn>River_Reconnected*(precipitation/1000)*Catchment_Area*Runoff_Coefficient</eqn>
				<non_negative/>
				<units>Cubic Meters/Years</units>
			</flow>
			<flow name="Precipitation Direct">
				<eqn>(precipitation/1000)*Lagoon_Area</eqn>
				<non_negative/>
				<units>Cubic Meters/Years</units>
			</flow>
			<flow name="Evaporative loss via Turc PET">
				<eqn>PET*Lagoon_Area</eqn>
				<non_negative/>
				<units>Cubic Meters/Years</units>
			</flow>
			<aux name="Catchment Area">
				<eqn>22000000</eqn>
				<units>Square Meters</units>
			</aux>
			<aux name="Lagoon Area">
				<eqn>2255000</eqn>
				<units>Square Meters</units>
			</aux>
			<aux name="Runoff Coefficient">
				<eqn>0.15</eqn>
				<units>Dimensionless</units>
			</aux>
			<aux name="Salinity">
				<eqn>Salt_Mass/Lagoon_Volume</eqn>
				<units>PSU</units>
			</aux>
			<aux name="temperature">
				<eqn>TIME</eqn>
				<gf>
					<yscale min="0" max="50"/>
					<xpts>2001,2002,2003,2004,2005,2006,2007,2008,2009,2010,2011,2012,2013,2014,2015,2016,2017,2018,2019,2020,2021,2022,2023,2024,2025,2026,2027,2028,2029,2030,2031,2032,2033,2034,2035,2036,2037,2038,2039,2040,2041,2042,2043,2044,2045,2046,2047,2048,2049,2050</xpts>
					<ypts>18.6,18.5,18.6,18.4,18,18,18.7,18.7,18.6,19.1,18.3,19.1,19,18.9,18.8,19.1,18.8,19.5,19.2,19.1,20.46,20.35,20.46,20.24,19.8,19.8,20.57,20.57,20.46,21.01,20.13,21.01,20.9,20.79,20.68,21.01,20.68,21.45,21.12,21.01,20.46,20.35,20.46,20.24,19.8,19.8,20.57,20.57,20.46,21.01</ypts>
				</gf>
				<units>Celsius</units>
			</aux>
			<aux name="precipitation">
				<eqn>TIME</eqn>
				<gf>
					<yscale min="0" max="1400"/>
					<xpts>2001,2002,2003,2004,2005,2006,2007,2008,2009,2010,2011,2012,2013,2014,2015,2016,2017,2018,2019,2020,2021,2022,2023,2024,2025,2026,2027,2028,2029,2030,2031,2032,2033,2034,2035,2036,2037,2038,2039,2040,2041,2042,2043,2044,2045,2046,2047,2048,2049,2050</xpts>
					<ypts>731.1,883.9,824.5,548.6,852.9,537.3,496,448.6,972.7,601.4,646.2,636.3,789.1,711.3,737.7,643.3,878.6,915.2,992.3,618.3,657.99,795.51,742.05,493.74,767.61,483.57,446.4,403.74,875.43,541.26,581.58,572.67,710.19,640.17,663.93,578.97,790.74,823.68,893.07,556.47,657.99,795.51,742.05,493.74,767.61,483.57,446.4,403.74,875.43,541.26</ypts>
				</gf>
				<units>Millimeters per year</units>
			</aux>
			<aux name="PET">
				<eqn>((300+25*temperature+0.05*temperature^3)/1000)</eqn>
				<units>meters per year</units>
			</aux>
			<flow name="Sea exchange">
				<eqn>IF (Lagoon_Depth &gt; 0.77) THEN 
    -(Lagoon_Volume - (0.77 * 2255000)) / DT 
ELSE IF (Lagoon_Depth &lt; 0.60) THEN 
    ((0.60 * 2255000) - Lagoon_Volume) / DT 
ELSE 
    0</eqn>
				<units>Cubic Meters/Years</units>
			</flow>
			<flow name="Tyflomitis Groundwater">
				<eqn>500000*Historical_Mean_Precipitation</eqn>
				<non_negative/>
				<units>Cubic Meters/Years</units>
			</flow>
			<aux name="Historical Mean Precipitation">
				<eqn>precipitation/723.27</eqn>
				<units>Dimensionless</units>
			</aux>
			<aux name="Lagoon Depth">
				<eqn>Lagoon_Volume/2255000</eqn>
				<units>Meters</units>
			</aux>
			<aux name="Ag Withdrawal">
				<eqn>(MAX(0, Xerolagados_Catchment_Runoff+Tyflomitis_Groundwater))</eqn>
				<units>Cubic Meters per year</units>
			</aux>
			<stock name="Salt Mass">
				<eqn>51300000</eqn>
				<inflow>salt_inflow</inflow>
				<outflow>Salt_outflow</outflow>
				<non_negative/>
				<units>kilogram</units>
			</stock>
			<flow name="salt inflow">
				<eqn>(IF Sea_exchange &gt; 0 THEN Sea_exchange * 38 ELSE 0) +(1500000*38)</eqn>
				<non_negative/>
				<units>kilogram/Years</units>
			</flow>
			<flow name="Salt outflow">
				<eqn>(IF Sea_exchange &lt; 0 THEN ABS(Sea_exchange)* Salinity ELSE 0)+(1500000*Salinity)</eqn>
				<non_negative/>
				<units>kilogram/Years</units>
			</flow>
			<aux name="River Reconnected">
				<eqn>0.5</eqn>
			</aux>
		</variables>
